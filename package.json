{
  "name": "cvrde-demo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm run test -w backend",
    "smoke": "npm run build -w backend && node scripts/smoke.mjs",
    "check:vercel-entry": "node --import tsx scripts/check-vercel-entry.mjs",
    "start:local": "npm run build && node scripts/serve-built.mjs",
    "migrate": "npm run migrate -w backend",
    "backfill:files": "npm run backfill:files -w backend",
    "seed": "npm run seed -w backend",
    "reset:demo": "npm run migrate && npm run seed"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "pptxgenjs": "^4.0.0"
  },
  "overrides": {
    "image-size": "^2.0.4"
  }
}
